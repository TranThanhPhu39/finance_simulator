# Never use a funded production wallet for the demo; do not commit .env.
LOCAL_RPC_URL=http://127.0.0.1:8545
# Set these in your terminal before running DeployLocal. No default signing key.
DEPLOYER_PRIVATE_KEY=
SESSION_ADDRESS=
# Public Fuji RPC is used only by future explicit demo deployments.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Dedicated testnet wallet only. Set in local terminal/.env, never send it in chat.
FUJI_DEPLOYER_PRIVATE_KEY=
